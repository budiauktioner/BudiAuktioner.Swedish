{
  "metadata": [
    {
      "src": [
        {
          "files": ["src/Buildi.Primitives/Buildi.Primitives.csproj"],
          "src": "../"
        }
      ],
      "dest": "api",
      "properties": {
        "TargetFramework": "net10.0"
      },
      "memberLayout": "samePage"
    }
  ],
  "build": {
    "content": [
      {
        "files": ["api/**.yml", "api/index.md"]
      },
      {
        "files": ["articles/**.md", "articles/**/toc.yml", "toc.yml", "*.md"]
      }
    ],
    "resource": [
      {
        "files": ["images/**"]
      }
    ],
    "output": "_site",
    "template": ["default", "modern"],
    "globalMetadata": {
      "_appTitle": "Buildi.Primitives",
      "_appFooter": "Buildi.Primitives &mdash; MIT License",
      "_enableSearch": true,
      "_disableContribution": false
    },
    "sitemap": {
      "baseUrl": "https://budiauktioner.github.io/Buildi.Primitives",
      "changefreq": "weekly"
    }
  }
}
